#!/bin/sh

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
    echo "Error: Environment variables are not set." 1>&2
    echo "Please run this script through synopkg." 1>&2
    exit 1
fi

# NOTE: this file is sourced by installer and start-stop-status (including on
# every "status" poll). Top level must only compute variables. Anything with
# side effects belongs in a service_* function below.

# Bump when the layout of ${SYNOPKG_PKGVAR} changes; migrate_config() uses it.
# History: 2 = first migration (but postinst recorded it before the migration
# ran, so upgrades skipped the cleanup); 3 = the migration really runs, and
# also repairs installations that were marked 2 without being cleaned;
# 4 = one log file (TorrServer.log) instead of service.log / Helper.log;
# 5 = no root helpers any more: the certificate source files are gone.
CONFIG_SCHEMA=5

CONFIG_DIR="${SYNOPKG_PKGVAR:-/var/packages/${SYNOPKG_PKGNAME}/var}"
# One log for everything: TorrServer writes to it itself (-l, append mode), and
# the start/stop/restart scripts and the Helper append to it too. Nothing truncates it; the Helper rotates it by size.
LOG_FILE="${CONFIG_DIR}/TorrServer.log"
TORRSERVER_LOG="${LOG_FILE}"
PID_FILE="${CONFIG_DIR}/${SYNOPKG_PKGNAME}.pid"
SCHEMA_FILE="${CONFIG_DIR}/config.schema"

# service_log SOURCE MESSAGE: one line in TorrServer's own format
# ("2026/10/06 17:36:22 UTC0 ..."), so the lines sort and read together.
service_log()
{
    printf '%s %s: %s\n' "$(date -u '+%Y/%m/%d %H:%M:%S UTC0')" "$1" "$2" >> "${LOG_FILE}"
}

read_port_file()
{
    # $1 = file, $2 = default
    _value="$(cat "$1" 2>/dev/null)"
    case "${_value}" in
        ''|*[!0-9]*)
            echo "$2"
            return
            ;;
    esac

    if [ "${_value}" -ge 1 ] 2>/dev/null && [ "${_value}" -le 65535 ] 2>/dev/null; then
        echo "${_value}"
    else
        echo "$2"
    fi
}

TORRSERVER_PORT="$(read_port_file "${CONFIG_DIR}/torrserver.port" 8090)"
HTTPS_PORT="$(read_port_file "${CONFIG_DIR}/torrserver.https.port" 8091)"

AUTH_ARGS=""
if [ "$(cat "${CONFIG_DIR}/torrserver.auth" 2>/dev/null)" = "1" ] &&
   [ -r "${CONFIG_DIR}/accs.db" ]; then
    AUTH_ARGS="-a"
fi

HTTPS_ENABLED="0"
SSL_ARGS=""
if [ "$(cat "${CONFIG_DIR}/torrserver.https" 2>/dev/null)" = "1" ]; then
    HTTPS_ENABLED="1"
    SSL_ARGS="--ssl --sslport ${HTTPS_PORT}"

    if [ "$(cat "${CONFIG_DIR}/torrserver.force.https" 2>/dev/null)" = "1" ]; then
        SSL_ARGS="${SSL_ARGS} --force-https"
    fi
fi

# SERVICE_COMMAND is split on whitespace by start-stop-status, so a FUSE path
# with spaces cannot be passed safely and is skipped.
FUSE_ARGS=""
if [ "$(cat "${CONFIG_DIR}/torrserver.fuse" 2>/dev/null)" = "1" ]; then
    _dir="$(cat "${CONFIG_DIR}/torrserver.dir" 2>/dev/null)"

    if [ -n "${_dir}" ]; then
        _fuse_path="${_dir%/}/FUSE"

        case "${_fuse_path}" in
            *[[:space:]]*)
                FUSE_SKIPPED_REASON="FUSE path contains spaces: ${_fuse_path}"
                ;;
            *)
                if [ -d "${_fuse_path}" ]; then
                    FUSE_ARGS="--fusepath ${_fuse_path}"
                fi
                ;;
        esac
    fi
fi

# Python 3 for the Helper (it needs 3.7 or newer). DSM 7 keeps one in the system
# partition; if it is not there, the Python 3 package from Package Center is
# used. Only file tests here: this file is sourced on every status poll.
# PYTHON_CANDIDATES can be set by the tests.
PYTHON_BIN=""
# shellcheck disable=SC2086
for _py in ${PYTHON_CANDIDATES:-/bin/python3 /usr/bin/python3 /usr/local/bin/python3 /var/packages/Python3*/target/usr/bin/python3}; do
    if [ -x "${_py}" ]; then
        PYTHON_BIN="${_py}"
        break
    fi
done

HELPER_COMMAND="${PYTHON_BIN:-/bin/python3} ${SYNOPKG_PKGDEST}/helper/helper.py"
TORRSERVER_COMMAND="${SYNOPKG_PKGDEST}/bin/TorrServer -d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} ${AUTH_ARGS} ${SSL_ARGS} ${FUSE_ARGS} -l ${TORRSERVER_LOG}"

# One command per line; the helper must stay first (its pid is the first one
# in the pid file, and restart-torrserver keeps it).
SERVICE_COMMAND="${HELPER_COMMAND}
${TORRSERVER_COMMAND}"

update_firewall_port()
{
    sc_file="${SYNOPKG_PKGDEST}/ui/TorrServer.sc"
    firewall_ports="${TORRSERVER_PORT}"

    if [ "${HTTPS_ENABLED}" = "1" ]; then
        firewall_ports="${firewall_ports},${HTTPS_PORT}"
    fi

    # The helper listens on 127.0.0.1 only (reached through DSM nginx), so its
    # port is intentionally not exposed here.
    new_content="[torrserver]
title=\"TorrServer DSM\"
desc=\"TorrServer DSM\"
port_forward=\"yes\"
dst.ports=\"${firewall_ports}/tcp\""

    if [ "$(cat "${sc_file}" 2>/dev/null)" = "${new_content}" ]; then
        return 0
    fi

    printf '%s\n' "${new_content}" > "${sc_file}" 2>/dev/null || return 0
    /usr/syno/sbin/synopkghelper update "${SYNOPKG_PKGNAME}" port-config >/dev/null 2>&1
}

# TorrServer mounts its FUSE folder itself and normally unmounts it when it
# ends. After a kill, a crash or a changed folder a mount can be left behind
# with nothing serving it; the folder then cannot be opened at all (not even in
# File Station). Called only while TorrServer is stopped: unmounts every
# leftover "fuse.torrserver" mount. MOUNTS_FILE and FUSERMOUNT_CMD can be set
# by the tests.
torrserver_is_running()
{
    for _cmdline in /proc/[0-9]*/cmdline; do
        _words="$(tr '\0' '\n' < "${_cmdline}" 2>/dev/null | head -n 2)"
        case "
${_words}
" in
            *"
${SYNOPKG_PKGDEST}/bin/TorrServer
"*)
                return 0
                ;;
        esac
    done
    return 1
}

cleanup_stale_fuse_mounts()
{
    _mounts="${MOUNTS_FILE:-/proc/mounts}"
    [ -r "${_mounts}" ] || return 0

    # A running TorrServer owns its mount: leave everything alone.
    if torrserver_is_running; then
        return 0
    fi

    _umount="${FUSERMOUNT_CMD:-}"
    if [ -z "${_umount}" ]; then
        for _candidate in fusermount fusermount3; do
            _umount="$(command -v "${_candidate}" 2>/dev/null)" && break
            _umount=""
        done
    fi

    while read -r _dev _mp _type _rest; do
        [ "${_type}" = "fuse.torrserver" ] || continue
        # /proc/mounts writes a space in a path as \040.
        _path="$(printf '%b' "${_mp}")"
        if [ -n "${_umount}" ] && ${_umount} -u -z -- "${_path}" >/dev/null 2>&1; then
            service_log service "Unmounted a leftover FUSE mount at ${_path}"
        else
            service_log service "Warning: a leftover FUSE mount at ${_path} could not be unmounted; as root run: umount -l '${_path}'"
        fi
    done < "${_mounts}"
}

# Called by start-stop-status right before the daemon is started.
service_prestart()
{
    if [ -z "${PYTHON_BIN}" ]; then
        service_log service "ERROR: Python 3 was not found, so the Helper cannot start. Install Python 3 from DSM Package Center, then restart the package."
    fi

    cleanup_stale_fuse_mounts

    if [ -n "${FUSE_SKIPPED_REASON}" ]; then
        service_log service "Warning: ${FUSE_SKIPPED_REASON}. FUSE is disabled for this start."
    fi

    if [ -d "${SYNOPKG_PKGDEST}/ui" ]; then
        update_firewall_port
    fi
}

# Files created by earlier package versions and no longer used.
OBSOLETE_VAR_FILES="torrserver.fuse.path cache.path"

# Files holding package settings (not TorrServer's own database/torrents).
SETTINGS_VAR_FILES="torrserver.port torrserver.auth accs.db torrserver.dir torrserver.fuse
torrserver.https torrserver.https.port torrserver.force.https cache.pending
helper.language"

remove_var_file()
{
    rm -f -- "${SYNOPKG_PKGVAR}/$1"
}

reset_settings()
{
    for f in ${SETTINGS_VAR_FILES}; do
        remove_var_file "${f}"
    done
}

migrate_config()
{
    if [ -z "${SYNOPKG_PKGVAR}" ] || [ ! -d "${SYNOPKG_PKGVAR}" ]; then
        return 0
    fi

    if [ "${wizard_reset_settings}" = "true" ]; then
        echo "Resetting package settings (requested in the upgrade wizard)"
        reset_settings
    fi

    previous="$(cat "${SCHEMA_FILE}" 2>/dev/null)"
    case "${previous}" in
        ''|*[!0-9]*) previous=0 ;;
    esac

    if [ "${previous}" -lt "${CONFIG_SCHEMA}" ]; then
        echo "Migrating configuration schema ${previous} -> ${CONFIG_SCHEMA}"

        for f in ${OBSOLETE_VAR_FILES}; do
            remove_var_file "${f}"
        done

        # Earlier versions kept separate logs; TorrServer.log is the only one now.
        for f in service.log Helper.log Helper.log.1; do
            remove_var_file "${f}"
        done

        # Versions before schema 2 copied the DSM system certificate over
        # server.pem/server.key regardless of the selected mode. Drop it so a
        # "self" mode TorrServer uses its own certificate again.
        mode="$(cat "${SYNOPKG_PKGVAR}/torrserver.ssl.mode" 2>/dev/null)"
        case "${mode}" in
            dsm|manual) ;;
            *)
                remove_var_file server.pem
                remove_var_file server.key
                ;;
        esac

        # Version 2.8 has no root helpers and no certificate source setting.
        # A server.pem/server.key copied earlier stays and keeps working, but
        # nothing renews it any more.
        for f in torrserver.ssl.mode torrserver.ssl.cert torrserver.ssl.key; do
            remove_var_file "${f}"
        done

        # A pid file surviving an upgrade is always stale (service is stopped).
        remove_var_file "${SYNOPKG_PKGNAME}.pid"
    fi

    # Leftovers from interrupted writes.
    find "${SYNOPKG_PKGVAR}" -maxdepth 1 -type f \
        \( -name '*.tmp' -o -name '*.stage' \) -exec rm -f -- {} \; 2>/dev/null

    printf '%s\n' "${CONFIG_SCHEMA}" > "${SCHEMA_FILE}"
}

service_postinst()
{
    # DSM runs postinst for installs AND for upgrades, and it runs it BEFORE
    # postupgrade. Recording the schema here (as an earlier version did) made
    # the migration in postupgrade believe there was nothing to do. So the
    # migration itself runs here; migrate_config records the schema last.
    migrate_config
}

service_postupgrade()
{
    migrate_config
    return 0
}
